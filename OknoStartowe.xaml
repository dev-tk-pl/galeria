<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GaleriaDesktop.OknoStartowe"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galeria">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Okienko przed startem aplikacji: sprawdzenie i ewentualne pobranie aktualizacji -->
    <Grid x:Name="Korzen" Padding="32,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Image x:Name="Ikona" Width="40" Height="40" />
            <TextBlock Text="Galeria" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Tekst" Grid.Row="1" Text="Sprawdzanie dostępności aktualizacji…"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ProgressBar x:Name="Pasek" Grid.Row="2" IsIndeterminate="True" />
    </Grid>
</Window>
